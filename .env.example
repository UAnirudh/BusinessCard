# Leave this empty for local development: the app then uses an embedded
# PGlite database stored in .data/pglite, with migrations applied on boot.
# Set a Postgres connection string for production (Vercel Postgres, Neon, Supabase, RDS…).
DATABASE_URL=
# Set true only when the managed database uses a self-signed TLS certificate
# (Railway private Postgres). TLS remains enabled; certificate-chain validation is skipped.
TAPPD_ALLOW_SELF_SIGNED_DATABASE_CERT=false

# Public origin used for QR codes, card links and metadata.
# Local: http://localhost:3000
# Production: set to the HTTPS Railway service domain after it has been generated.
# Proposed service domain: https://tappd.up.railway.app (not assigned yet).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitored support and privacy inbox. Leave empty until the operator controls it.
TAPPD_SUPPORT_EMAIL=

# Transactional email delivery for password recovery and account email confirmation (Resend).
# Configure a verified sending domain in production.
RESEND_API_KEY=
TAPPD_EMAIL_FROM=

# Apple Wallet passes stay off until a Pass Type ID and signing certificate are configured.
# Base64-encode PEM certificate/key contents; never commit production values.
# The server runtime must have OpenSSL available (or set OPENSSL_BIN to its path).
OPENSSL_BIN=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT_BASE64=

# Google Wallet passes stay off until an approved Generic Pass class exists.
# Class ID format: <issuer ID>.<class suffix>. Store service-account JSON as base64.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Optional: Postgres pool size per serverless instance (default 5).
# PG_POOL_MAX=5
