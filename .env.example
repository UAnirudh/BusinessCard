# Leave this empty for local development: the app then uses an embedded
# PGlite database stored in .data/pglite, with migrations applied on boot.
# Set a Postgres connection string for production (Vercel Postgres, Neon, Supabase, RDS…).
DATABASE_URL=

# Public origin used for QR codes, card links and metadata.
# Local: http://localhost:3000
# Production: https://your-domain.com (set this in Vercel → Settings → Environment Variables)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Postgres pool size per serverless instance (default 5).
# PG_POOL_MAX=5
